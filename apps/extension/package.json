{
  "name": "@zero-vault/extension",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node build.mjs",
    "build:firefox": "tsc -p tsconfig.json --noEmit && node build.mjs firefox",
    "package": "node build.mjs && node package.mjs",
    "package:firefox": "tsc -p tsconfig.json --noEmit && node build.mjs firefox && node package.mjs firefox",
    "sign:firefox": "bash scripts/sign-firefox.sh",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^3.25.42",
    "@zero-vault/browser-vault": "workspace:*",
    "@zero-vault/crypto-core-wasm": "workspace:*",
    "@serenity-kit/opaque": "^1.1.0",
    "@zero-vault/shared": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/chrome": "^0.0.321",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "@vitest/coverage-v8": "^3.2.6",
    "vitest": "^3.2.6"
  }
}
