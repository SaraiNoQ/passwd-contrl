# Copy to /root/dev/zero-vault-android-secrets/autofill-fixture.env on campus-server.
# Keep the env file and keystore outside Git, set both to mode 600, and use a
# dedicated fixture key rather than the Zero Vault production-app signing key.
ZERO_VAULT_AUTOFILL_FIXTURE_STORE_FILE=/run/zero-vault-secrets/autofill-fixture.keystore
ZERO_VAULT_AUTOFILL_FIXTURE_STORE_PASSWORD=replace-me
ZERO_VAULT_AUTOFILL_FIXTURE_KEY_ALIAS=replace-me
ZERO_VAULT_AUTOFILL_FIXTURE_KEY_PASSWORD=replace-me
ZERO_VAULT_AUTOFILL_FIXTURE_SIGNING_CERT_SHA256=64_HEX_CHARACTERS
