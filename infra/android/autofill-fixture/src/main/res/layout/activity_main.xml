<?xml version="1.0" encoding="utf-8"?>
<ScrollView
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:fillViewport="true">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:padding="24dp">

    <requestFocus />

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="Zero Vault Autofill Fixture"
      android:textAppearance="@android:style/TextAppearance.Material.Headline"
      android:textStyle="bold" />

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:text="Use a dedicated test credential. The fixture never stores or logs field values."
      android:textAppearance="@android:style/TextAppearance.Material.Body1" />

    <EditText
      android:id="@+id/fixture_username"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="24dp"
      android:autofillHints="username"
      android:hint="Username"
      android:importantForAutofill="yes"
      android:inputType="textEmailAddress"
      android:maxLines="1" />

    <EditText
      android:id="@+id/fixture_password"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:autofillHints="password"
      android:hint="Password"
      android:importantForAutofill="yes"
      android:inputType="textPassword"
      android:maxLines="1" />

    <Button
      android:id="@+id/fixture_autofill_button"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="24dp"
      android:text="Request Autofill" />

    <Button
      android:id="@+id/fixture_credential_button"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:text="Request Password Credential" />

    <TextView
      android:id="@+id/fixture_status"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="20dp"
      android:accessibilityLiveRegion="polite"
      android:text="No credential received"
      android:textAppearance="@android:style/TextAppearance.Material.Body1" />
  </LinearLayout>
</ScrollView>
